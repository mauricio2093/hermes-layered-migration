[Unit]
Description=Hermes maintenance orchestrator (versions, daily backup, candidate preparation)
Documentation=https://github.com/mauricio2093/hermes-layered-migration/blob/main/docs/updater.md
# Sin Wants=/Requires= sobre hermes-gateway.service: igual que hermes-maint,
# tiene que poder informar de un gateway caido, no levantarlo a escondidas.
# Esta ejecucion NUNCA modifica produccion: solo apply (otra unit) lo hace.

[Service]
Type=oneshot
Environment=HERMES_HOME=%h/.hermes
# El PATH del gestor de usuario no incluye ~/.local/bin (claude, codex) ni
# ~/.opencode/bin: sin esto, la deteccion de versiones los daba por "no
# instalados" (2026-10-19, primera ejecucion real).
Environment=PATH=%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/hermes-updater run --trigger timer
# 3 = otra ejecucion tiene el candado (el candado funcionando).
# 4 = candidato preparado y PENDIENTE de aprobacion: es el resultado esperado
#     de un dia con actualizacion de Hermes, no un fallo.
# 6 BLOCKED, 7 FAILED y el resto son hallazgos y deben verse en rojo.
SuccessExitStatus=3 4
# Preparar un candidato (venv + ~2000 tests + suite de hermes-control) tarda
# 30-90 min en este equipo. 3 h acota un cuelgue; cada fase tiene su timeout.
TimeoutStartSec=3h
UMask=0077
Nice=10
IOSchedulingClass=idle
# Las suites corren en su propio scope (systemd-run --scope, MemoryMax=1800M);
# este limite cubre al orquestador y a pip/git.
MemoryMax=2G
NoNewPrivileges=yes
# SIN RestrictSUIDSGID: con tar 1.35 en este kernel, su filtro seccomp hace que
# TODA creacion de fichero de tar falle ("Cannot open: Function not
# implemented"). El restore temporal del backup diario no extraia nada y el
# backup quedaba sin verificar (2026-10-19, primera ejecucion real; aislado
# probando cada propiedad por separado).
LockPersonality=yes
# Sin [Install]: lo activa el timer.
